{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://latvian-b.local/schemas/sentence-surgery-passive.schema.json",
  "title": "Sentence Surgery passive-voice dataset",
  "type": "object",
  "required": ["meta", "items"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "topic",
          "source",
          "target_lv",
          "target_en",
          "broken_lv",
          "errors",
          "word_bank"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target_lv": { "type": "string", "minLength": 1 },
          "target_en": { "type": "string", "minLength": 1 },
          "broken_lv": { "type": "string", "minLength": 1 },
          "errors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "wrong", "correct"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["aux_tense", "negation", "participle_agreement"]
                },
                "wrong": { "type": "string", "minLength": 1 },
                "correct": { "type": "string", "minLength": 1 }
              }
            }
          },
          "word_bank": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
